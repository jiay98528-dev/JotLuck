{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jotluck.installed-app.manifest.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "releaseId",
    "candidate",
    "ci",
    "installer",
    "application",
    "catalog",
    "rawReport",
    "transcript",
    "attachments",
    "requiredCasesTree",
    "performance"
  ],
  "properties": {
    "schema": { "const": "jotluck.installed-app.manifest.v2" },
    "releaseId": { "type": "string", "minLength": 1 },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "version"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "version": { "type": "string", "const": "0.1.0-preview" }
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "repository",
        "runId",
        "runAttempt",
        "candidateArtifact",
        "evidenceArtifact",
        "materialization"
      ],
      "properties": {
        "provider": { "const": "github-actions" },
        "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "runId": { "type": "string", "minLength": 1 },
        "runAttempt": { "type": "integer", "minimum": 1 },
        "candidateArtifact": { "$ref": "#/$defs/githubArtifact" },
        "evidenceArtifact": { "$ref": "#/$defs/githubArtifact" },
        "materialization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["job", "step"],
          "properties": {
            "job": { "const": "Installed-app Evidence Materialization" },
            "step": { "const": "Materialize managed evidence bundle" }
          }
        }
      }
    },
    "installer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "bytes", "sha256"],
      "properties": {
        "fileName": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "bytes", "sha256"],
      "properties": {
        "fileName": { "const": "jotluck.exe" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "catalog": { "$ref": "installed-app-raw-report-v2.schema.json#/$defs/artifact" },
    "rawReport": { "$ref": "installed-app-raw-report-v2.schema.json#/$defs/artifact" },
    "transcript": { "$ref": "installed-app-raw-report-v2.schema.json#/$defs/artifact" },
    "attachments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256", "caseId", "kind"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "caseId": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["case-result", "case-artifact"] }
        }
      }
    },
    "requiredCasesTree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "gitTreeSha"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "gitTreeSha": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" }
      }
    },
    "performance": { "$ref": "installed-app-raw-report-v2.schema.json#/$defs/performance" }
  },
  "$defs": {
    "githubArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "digest", "sizeInBytes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "name": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "sizeInBytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
