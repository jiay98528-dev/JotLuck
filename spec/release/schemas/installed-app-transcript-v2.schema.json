{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jotluck.installed-app.transcript.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "releaseId",
    "candidateCommit",
    "rawReportSha256",
    "transcriber",
    "executions",
    "performance"
  ],
  "properties": {
    "schema": { "const": "jotluck.installed-app.transcript.v2" },
    "releaseId": { "type": "string", "minLength": 1 },
    "candidateCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "rawReportSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "transcriber": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "const": "independent-readonly" }
      }
    },
    "executions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "adapter", "counters", "outputSha256"],
        "properties": {
          "caseId": { "type": "string", "minLength": 1 },
          "adapter": { "type": "string", "minLength": 1 },
          "counters": {
            "type": "object",
            "additionalProperties": false,
            "required": ["executed", "passed", "failed", "skipped"],
            "properties": {
              "executed": { "type": "integer", "minimum": 1 },
              "passed": { "type": "integer", "minimum": 1 },
              "failed": { "const": 0 },
              "skipped": { "const": 0 }
            }
          },
          "outputSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "performance": { "$ref": "installed-app-raw-report-v2.schema.json#/$defs/performance" }
  }
}
