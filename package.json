{
  "name": "jotluck",
  "version": "0.1.0-preview",
  "private": true,
  "description": "Lightweight, local-first Markdown note-taking tool",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @jotluck/app dev",
    "build": "pnpm --filter @jotluck/app build",
    "preview": "pnpm --filter @jotluck/app preview",
    "collect-web-corpus": "tsx scripts/collect-web-corpus.ts",
    "generate-autocomplete-synthetic-corpus": "tsx scripts/generate-autocomplete-synthetic-corpus.ts",
    "autocomplete-v2s": "node --max-old-space-size=12288 --import tsx scripts/autocomplete-v2s/cli.ts",
    "verify-autocomplete-v2s-evidence": "node scripts/verify-autocomplete-v2s-evidence.mjs",
    "build-autocomplete-v2s-evaluator-tree": "node scripts/build-autocomplete-v2s-evaluator-tree.mjs",
    "publish-autocomplete-v2s-final": "tsx scripts/publish-autocomplete-v2s-final.ts",
    "lint": "eslint .",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"*.{json,mjs,yml,yaml}\" \".github/**/*.yml\" \"AGENTS.md\" \"tool.md\" \"doc/**/*.md\" \"spec/**/*.md\" \"memory/**/*.md\" \"e2e/**/*.{ts,mjs}\" \"scripts/**/*.{ts,mjs,json}\" \"packages/**/*.{ts,vue,css,json,md,yaml}\"",
    "format:fix": "prettier --write \"*.{json,mjs,yml,yaml}\" \".github/**/*.yml\" \"AGENTS.md\" \"tool.md\" \"doc/**/*.md\" \"spec/**/*.md\" \"memory/**/*.md\" \"e2e/**/*.{ts,mjs}\" \"scripts/**/*.{ts,mjs,json}\" \"packages/**/*.{ts,vue,css,json,md,yaml}\"",
    "test": "pnpm --filter @jotluck/app test",
    "test:coverage": "pnpm --filter @jotluck/app test:coverage",
    "test:e2e:autocomplete-quality": "pnpm --filter @jotluck/app test:e2e:autocomplete-quality",
    "test:e2e:autocomplete-layers": "pnpm --filter @jotluck/app test:e2e:autocomplete-layers",
    "test:e2e:autocomplete-rc": "pnpm --filter @jotluck/app test:e2e:autocomplete-rc",
    "test:tauri:webview-smoke": "node e2e/tauri/tauri-webview-smoke.spec.mjs",
    "audit:js:prod": "pnpm audit --prod --audit-level high",
    "audit:js:all": "pnpm audit --audit-level high",
    "audit:rust": "cargo audit --file packages/app/src-tauri/Cargo.lock",
    "release:rc-gate": "node scripts/release-rc-gate.mjs",
    "release:preview-gate": "node scripts/release/verify-preview-release-gate.mjs",
    "typecheck": "pnpm --filter @jotluck/app typecheck",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "prettier --write"
    ],
    "*.{json,md,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@playwright/test": "^1.60.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.60.1",
    "webdriverio": "9.30.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.5.1",
  "dependencies": {
    "docx": "^9.7.1",
    "minisearch": "^7.2.0"
  }
}
